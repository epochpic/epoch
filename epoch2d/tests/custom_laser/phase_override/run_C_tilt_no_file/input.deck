begin:control
  nx = 64
  ny = 64
  t_end = 6.5 * femto
  x_min = -6 * micron
  x_max = 6 * micron
  y_min = -6 * micron
  y_max = 6 * micron
  stdout_frequency = 50
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
end:boundaries


begin:laser
  boundary = x_min
  pol = 0
  lambda = 1.0 * micron
  amp = 1.0e12
  use_custom_profile = T
  use_spatiotemporal_profile = F
  profile_data_file = spatial_profile.dat
  n_y = 6
  y_min = -4 * micron
  y_max = 4 * micron
  use_phase_from_file = F
  phase = 50.0 * y / micron
end:laser


begin:output
  dt_snapshot = 2.5 * femto
  grid = always
  ey = always
end:output
