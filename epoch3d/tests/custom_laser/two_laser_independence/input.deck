begin:control
  nx = 32
  ny = 32
  nz = 32
  t_end = 6.5 * femto
  x_min = -6 * micron
  x_max = 6 * micron
  y_min = -6 * micron
  y_max = 6 * micron
  z_min = -6 * micron
  z_max = 6 * micron
  stdout_frequency = 50
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries


begin:laser
  boundary = x_min
  pol = 0
  lambda = 1.0 * micron
  amp = 1.0e12
  use_custom_profile = T
  use_spatiotemporal_profile = T
  profile_data_file = profile_A.dat
  n_y_points = 10
  n_z_points = 8
  n_t_points = 5
  y_min = -4 * micron
  y_max = 4 * micron
  z_min = -3 * micron
  z_max = 3 * micron
  t_start = 0
  t_end = 6 * femto
end:laser


begin:laser
  boundary = x_min
  pol = 90
  lambda = 1.0 * micron
  amp = 1.0e12
  use_custom_profile = T
  use_spatiotemporal_profile = T
  profile_data_file = profile_B.dat
  n_y_points = 10
  n_z_points = 8
  n_t_points = 5
  y_min = -4 * micron
  y_max = 4 * micron
  z_min = -3 * micron
  z_max = 3 * micron
  t_start = 0
  t_end = 6 * femto
end:laser


begin:output
  dt_snapshot = 1.5 * femto
  grid = always
  ex = always
  ey = always
  ez = always
end:output
